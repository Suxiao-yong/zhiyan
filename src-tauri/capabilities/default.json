{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "智研默认权限集（Phase 1：sql/dialog/fs/process/opener；notification/stronghold 留到 Phase 4；Task 18 移除 http 插件权限）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "process:default",
    "process:allow-restart",
    "notification:default"
  ]
}
